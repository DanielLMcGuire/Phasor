#!/usr/bin/env phasor

include "std/type";
include "std/file";
include "std/rand";
include "std/sys";
include "std/io";
include "std/array";
include "sdl2/sdl2.phs";

define screenW = 800;
define screenH = 600;
define FPS = 60;
define FRAMETIME = 1000 / FPS;

fn main(args: string[]) -> int {
    var initResult: i64 = sdl_init(SDLC.INIT_VIDEO);
    if (initResult < 0) {
        puts_error("Failed to initialize SDL");
        return 1;
    }

    var window: SDLWindow = sdl_create_window("Phasor Bouncing Box", 100, 100, screenW, screenH, SDLC.WINDOW_SHOWN);
    if (window.handle == 0) {
        puts_error("Failed to create window");
        sdl_quit();
        return 1;
    }

    var renderer: SDLRenderer = sdl_create_renderer(window, -1, SDLC.RENDERER_PRESENTVSYNC);
    if (renderer.handle == 0) {
        puts_error("Failed to create renderer");
        sdl_destroy_window(window);
        sdl_quit();
        return 1;
    }

    var rectW: i64 = 100;
    var rectH: i64 = 100;

    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();

    rand_seed(seedA, seedB);
    
    var rectX: i64 = rand_next_range(0, screenW - rectW);
    var rectY: i64 = rand_next_range(0, screenH - rectH);
    var velX: i64 = 240;
    var velY: i64 = 180; 

    var running: bool = true;

    var lastTime: i64 = time();
    var targetFrameMs: i64 = FRAMETIME;

    while (running) {
        var currentTime: i64 = time();
        var deltaMs: i64 = currentTime - lastTime;

        if (deltaMs > 100)
            deltaMs = FRAMETIME;

        var event: SDLEvent = sdl_poll_event();
        while (event.type != 0) {
            if (event.type == SDLC.QUIT)
                running = false;

            event = sdl_poll_event();
        }
    
        rectX = rectX + (velX * deltaMs) / 1000;
        rectY = rectY + (velY * deltaMs) / 1000;

        if (rectX <= 0) {
            rectX = 0;
            velX = -velX;
        } else if (rectX + rectW >= screenW) {
            rectX = screenW - rectW;
            velX = -velX;
        }

        if (rectY <= 0) {
            rectY = 0;
            velY = -velY;
        } else if (rectY + rectH >= screenH) {
            rectY = screenH - rectH;
            velY = -velY;
        }

        sdl_set_render_draw_color(renderer, 0, 0, 0, 255);
        sdl_render_clear(renderer);

        sdl_set_render_draw_color(renderer, 255, 0, 0, 255);
        sdl_render_fill_rect(renderer, rectX, rectY, rectW, rectH);

        sdl_set_render_draw_color(renderer, 255, 255, 255, 255);
        sdl_render_draw_rect(renderer, rectX, rectY, rectW, rectH);

        sdl_render_present(renderer);

        var frameEndTime: i64 = time();
        var frameElapsed: i64 = frameEndTime - currentTime;
        var delayTime: i64 = targetFrameMs - frameElapsed;
        
        if (delayTime > 0)
            sdl_delay(delayTime);

        lastTime = currentTime; 
    }

    sdl_destroy_renderer(renderer);
    sdl_destroy_window(window);
    sdl_quit();

    return 0;
}

include "std/main";