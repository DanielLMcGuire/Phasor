#!/usr/bin/env phasor

include "std/type";
include "std/math";
include "std/file";
include "std/rand";
include "std/sys";
include "std/io";
include "std/array";
include "sdl2/sdl2.phs";

define screenW = 800;
define screenH = 600;
define FPS = 60;
define FRAMETIME = 1000 / FPS;

fn main(args: string[]) -> int {
    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();

    rand_seed(seedA, seedB);

    var initResult: i64 = sdl_init(SDLC.INIT_VIDEO);
    if (initResult < 0) {
        puts_error("Failed to initialize SDL");
        return 1;
    }

    var window: SDLWindow = sdl_create_window("Phasor SDL2 Demo", 100, 100, screenW, screenH, SDLC.WINDOW_SHOWN);
    if (window.handle == 0) {
        puts_error("Failed to create window");
        sdl_quit();
        return 1;
    }

    var renderer: SDLRenderer = window.sdl_create_renderer(-1, SDLC.RENDERER_PRESENTVSYNC);
    if (renderer.handle == 0) {
        puts_error("Failed to create renderer");
        sdl_destroy_window(window);
        sdl_quit();
        return 1;
    }

    var rectSize: Vec2 = Vec2{x: 100, y: 100};
    var rect: Vec2 = Vec2{x: rand_next_range(0, screenW - rectSize.x), y: rand_next_range(0, screenH - rectSize.y)};
    var vel: Vec2 = Vec2{x: 240, y: 180};
    var color: Vec3 = Vec3{x: 121, y: 165, z: 249};

    var running: bool = true;

    var lastTime: i64 = time();
    var targetFrameMs: i64 = FRAMETIME;

    while (running) {
        var currentTime: i64 = time();
        var deltaMs: i64 = currentTime - lastTime;

        if (deltaMs > 100)
            deltaMs = FRAMETIME;

        var event: SDLEvent = sdl_poll_event();
        while (event.type != 0) {
            if (event.type == SDLC.QUIT)
                running = false;

            event = sdl_poll_event();
        }
    
        rect.x = rect.x + (vel.x * deltaMs) / 1000;
        rect.y = rect.y + (vel.y * deltaMs) / 1000;

       if (rect.x <= 0) {
            rect.x = 0;
            vel.x = -vel.x;
            color.x = rand_next_range(0, 255);
            color.y = rand_next_range(0, 255);
            color.z = rand_next_range(0, 255);
        } else if (rect.x + rectSize.x >= screenW) {
            rect.x = screenW - rectSize.x;
            vel.x = -vel.x;
            color.x = rand_next_range(0, 255);
            color.y = rand_next_range(0, 255);
            color.z = rand_next_range(0, 255);
        }

        if (rect.y <= 0) {
            rect.y = 0;
            vel.y = -vel.y;
            color.x = rand_next_range(0, 255);
            color.y = rand_next_range(0, 255);
            color.z = rand_next_range(0, 255);
        } else if (rect.y + rectSize.y >= screenH) {
            rect.y = screenH - rectSize.y;
            vel.y = -vel.y;
            color.x = rand_next_range(0, 255);
            color.y = rand_next_range(0, 255);
            color.z = rand_next_range(0, 255);
        }

        renderer.sdl_set_render_draw_color(0, 0, 0, 255);
        renderer.sdl_render_clear();

        renderer.sdl_set_render_draw_color(color.x, color.y, color.z, 255);
        renderer.sdl_render_fill_rect(rect.x, rect.y, rectSize.x, rectSize.y);

        renderer.sdl_set_render_draw_color(255, 255, 255, 255);
        renderer.sdl_render_draw_rect(rect.x, rect.y, rectSize.x, rectSize.y);

        renderer.sdl_render_present();

        var frameEndTime: i64 = time();
        var frameElapsed: i64 = frameEndTime - currentTime;
        var delayTime: i64 = targetFrameMs - frameElapsed;
        
        if (delayTime > 0)
            sdl_delay(delayTime);

        lastTime = currentTime; 
    }

    renderer.sdl_destroy_renderer();
    window.sdl_destroy_window();
    sdl_quit();

    return 0;
}

include "std/main";