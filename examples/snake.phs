#!/usr/bin/env phasor

include "std/type";
include "std/file";
include "std/rand";
include "std/sys";
include "std/io";
include "std/array";
include "sdl2/sdl2.phs";

define screenW = 800;
define screenH = 700;
define FPS = 60;
define FRAMETIME = 1000 / FPS;

define CELL = 25;
define GRID_W = screenW / CELL;
define GRID_H = screenH / CELL;
define CAPACITY = GRID_W * GRID_H;
define MOVE_MS = 110;

fn is_on_snake(x: i64, y: i64, segX: i64[], segY: i64[], length: i64) -> bool {
    var i: i64 = 0;
    while (i < length) {
        if (segX[i] == x && segY[i] == y) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main(args: string[]) -> int {
    var initResult: i64 = sdl_init(SDLC.INIT_VIDEO);
    if (initResult < 0) {
        puts_error("Failed to initialize SDL");
        return 1;
    }

    var window: SDLWindow = sdl_create_window("Phasor Snake", 100, 100, screenW, screenH, SDLC.WINDOW_SHOWN);
    if (window.handle == 0) {
        puts_error("Failed to create window");
        sdl_quit();
        return 1;
    }

    var renderer: SDLRenderer = sdl_create_renderer(window, -1, SDLC.RENDERER_PRESENTVSYNC);
    if (renderer.handle == 0) {
        puts_error("Failed to create renderer");
        sdl_destroy_window(window);
        sdl_quit();
        return 1;
    }

    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();
    rand_seed(seedA, seedB);

    var segX: i64[1200];
    var segY: i64[1200];

    var startX: i64 = GRID_W / 2;
    var startY: i64 = GRID_H / 2;

    segX[0] = startX;     segY[0] = startY;
    segX[1] = startX - 1; segY[1] = startY;
    segX[2] = startX - 2; segY[2] = startY;
    var segLength: i64 = 3;

    var dirX: i64 = 1;
    var dirY: i64 = 0;
    var nextDirX: i64 = 1;
    var nextDirY: i64 = 0;

    var foodX: i64 = rand_next_range(0, GRID_W - 1);
    var foodY: i64 = rand_next_range(0, GRID_H - 1);
    while (is_on_snake(foodX, foodY, segX, segY, segLength)) {
        foodX = rand_next_range(0, GRID_W - 1);
        foodY = rand_next_range(0, GRID_H - 1);
    }

    var score: i64 = 0;
    var gameOver: bool = false;
    var running: bool = true;
    var lastMoveTime: i64 = time();

    while (running) {
        var frameStart: i64 = time();

        var event: SDLEvent = sdl_poll_event();
        while (event.type != 0) {
            if (event.type == SDLC.QUIT) {
                running = false;
            }
            else if (event.type == SDLC.KEYDOWN) {
                if (event.key_sym == SDLC.K_ESCAPE) {
                    running = false;
                }
                else if (event.key_sym == SDLC.K_UP && dirY == 0) {
                    nextDirX = 0; nextDirY = -1;
                }
                else if (event.key_sym == SDLC.K_DOWN && dirY == 0) {
                    nextDirX = 0; nextDirY = 1;
                }
                else if (event.key_sym == SDLC.K_LEFT && dirX == 0) {
                    nextDirX = -1; nextDirY = 0;
                }
                else if (event.key_sym == SDLC.K_RIGHT && dirX == 0) {
                    nextDirX = 1; nextDirY = 0;
                }
                else if (event.key_sym == SDLC.K_SPACE && gameOver) {
                    segX[0] = startX;     segY[0] = startY;
                    segX[1] = startX - 1; segY[1] = startY;
                    segX[2] = startX - 2; segY[2] = startY;
                    segLength = 3;

                    dirX = 1; dirY = 0;
                    nextDirX = 1; nextDirY = 0;

                    score = 0;
                    gameOver = false;
                    lastMoveTime = time();

                    foodX = rand_next_range(0, GRID_W - 1);
                    foodY = rand_next_range(0, GRID_H - 1);
                    while (is_on_snake(foodX, foodY, segX, segY, segLength)) {
                        foodX = rand_next_range(0, GRID_W - 1);
                        foodY = rand_next_range(0, GRID_H - 1);
                    }
                }
            }

            event = sdl_poll_event();
        }

        if (!gameOver) {
            var now: i64 = time();
            if (now - lastMoveTime >= MOVE_MS) {
                lastMoveTime = now;

                dirX = nextDirX;
                dirY = nextDirY;

                var newHeadX: i64 = segX[0] + dirX;
                var newHeadY: i64 = segY[0] + dirY;

                if (newHeadX < 0 || newHeadX >= GRID_W || newHeadY < 0 || newHeadY >= GRID_H) {
                    gameOver = true;
                }
                else if (is_on_snake(newHeadX, newHeadY, segX, segY, segLength)) {
                    gameOver = true;
                }
                else {
                    var ate: bool = (newHeadX == foodX && newHeadY == foodY);
                    var growBy: i64 = 0;
                    if (ate) growBy = 1;

                    var i: i64 = segLength - 1 + growBy;
                    while (i > 0) {
                        segX[i] = segX[i - 1];
                        segY[i] = segY[i - 1];
                        i = i - 1;
                    }
                    segX[0] = newHeadX;
                    segY[0] = newHeadY;

                    if (ate) {
                        segLength = segLength + 1;
                        score = score + 1;

                        foodX = rand_next_range(0, GRID_W - 1);
                        foodY = rand_next_range(0, GRID_H - 1);
                        while (is_on_snake(foodX, foodY, segX, segY, segLength)) {
                            foodX = rand_next_range(0, GRID_W - 1);
                            foodY = rand_next_range(0, GRID_H - 1);
                        }
                    }
                }
            }
        }

        if (gameOver) {
            sdl_set_render_draw_color(renderer, 40, 8, 8, 255);
        } else {
            sdl_set_render_draw_color(renderer, 18, 18, 18, 255);
        }
        sdl_render_clear(renderer);

        sdl_set_render_draw_color(renderer, 255, 70, 70, 255);
        sdl_render_fill_rect(renderer, foodX * CELL, foodY * CELL, CELL, CELL);

        var s: i64 = 0;
        while (s < segLength) {
            if (s == 0) {
                sdl_set_render_draw_color(renderer, 140, 230, 140, 255);
            } else {
                sdl_set_render_draw_color(renderer, 60, 180, 60, 255);
            }
            sdl_render_fill_rect(renderer, segX[s] * CELL, segY[s] * CELL, CELL - 2, CELL - 2);
            s = s + 1;
        }

        var pip: i64 = 0;
        var pipsToShow: i64 = score;
        if (pipsToShow > 40) pipsToShow = 40;
        while (pip < pipsToShow) {
            sdl_set_render_draw_color(renderer, 220, 220, 60, 255);
            sdl_render_fill_rect(renderer, 8 + pip * 14, 8, 10, 10);
            pip = pip + 1;
        }

        sdl_render_present(renderer);

        var frameElapsed: i64 = time() - frameStart;
        var delayTime: i64 = FRAMETIME - frameElapsed;
        if (delayTime > 0) {
            sdl_delay(delayTime);
        }
    }

    sdl_destroy_renderer(renderer);
    sdl_destroy_window(window);
    sdl_quit();

    return 0;
}

include "std/main";