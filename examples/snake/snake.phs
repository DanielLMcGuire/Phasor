#!/usr/bin/env phasor

include "std/type";
include "std/ini";
include "std/math";
include "std/file";
include "std/rand";
include "std/sys";
include "std/io";
include "std/array";
include "sdl2/sdl2.phs";

define screenW = 800;
define screenH = 700;
define FPS = 60;
define FRAMETIME = 1000 / FPS;

define CELL = 25;
define GRID_W = screenW / CELL;
define GRID_H = screenH / CELL;
define MOVE_MS = 110;
define TIMEF = "%Y-%m-%dT%I:%M:%SZ";

fn is_on_snake(pos: Vec2, segX: i64[], seqY: i64[], length: i64) -> bool {
    var i: i64 = 0;
    while (i < length) {
        if (segX[i] == pos.x && segY[i] == pos.y) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn place_food(segX: i64[], segY: i64[], length: i64) -> Vec2 {
    var food: Vec2 = Vec2{
        x: rand_next_range(0, GRID_W - 1),
        y: rand_next_range(0, GRID_H - 1)
    };
    while (is_on_snake(food, segX, segY, length)) {
        food.x = rand_next_range(0, GRID_W - 1);
        food.y = rand_next_range(0, GRID_H - 1);
    }
static_if (DEBUG)
    putf("%s - placing food at %O...", localtimef(TIMEF), food);
static_endif
    return food;
}

fn dir_from_key(key: i64, curDirX: i64, curDirY: i64, curNextX: i64, curNextY: i64) -> Vec2 {
    if ((key == SDLC.K_UP || key == SDLC.K_w) && curDirY == 0) {
        return Vec2 { x: 0, y: -1 };
    }
    if ((key == SDLC.K_DOWN || key == SDLC.K_s) && curDirY == 0) {
        return Vec2 { x: 0, y: 1 };
    }
    if ((key == SDLC.K_LEFT || key == SDLC.K_a) && curDirX == 0) {
        return Vec2 { x: -1, y: 0 };
    }
    if ((key == SDLC.K_RIGHT || key == SDLC.K_d) && curDirX == 0) {
        return Vec2 { x: 1, y: 0 };
    }
    return Vec2 { x: curNextX, y: curNextY };
}

fn is_corner_turn(dx1: i64, dy1: i64, dx2: i64, dy2: i64) -> bool {
    return dx1 != dx2 || dy1 != dy2;
}

struct snake_palette {
    gameOverBack: Vec4,
    normalBack: Vec4,
    food: Vec4,
    snake_head: Vec4,
    snake_body: Vec4,
    led_on: Vec4,
    led_off: Vec4
}

var palette: snake_palette;

static_if (EMBEDDED)
palette = snake_palette{
    gameOverBack: rgb(40, 8, 8).matrixvec4(),
    normalBack: rgb(18, 18, 18).matrixvec4(),
    food: rgb(255, 60, 70).matrixvec4(),
    snake_head: rgb(140, 230, 140).matrixvec4(),
    snake_body: rgb(60, 180, 60).matrixvec4(),
    led_on: rgb(40, 40, 220).matrixvec4(),
    led_off: rgb(12, 24, 60).matrixvec4()
};
static_endif

define DIGIT_W = 26;
define DIGIT_H = 46;
define SEG_THICK = 6;
define DIGIT_GAP = 10;
define SCORE_Y = 12;
define SCORE_X = (screenW - (DIGIT_W * 3 + DIGIT_GAP * 2)) / 2;

include "led.phs";

fn render_frame(
    renderer: SDLRenderer,
    segX: i64[], segY: i64[], prevSegX: i64[], prevSegY: i64[], segLength: i64,
    corners: i64[][], cornerCount: i64,
    food: Vec2,
    score: i64, gameOver: bool,
    tScaled: i64
) {
    if (gameOver) {
        renderer.sdl_set_render_draw_color_vec(palette.gameOverBack);
    } else {
        renderer.sdl_set_render_draw_color_vec(palette.normalBack);
    }
    sdl_render_clear(renderer);

    renderer.sdl_set_render_draw_color_vec(palette.food);
    renderer.sdl_render_fill_rect(food.x * CELL, food.y * CELL, CELL, CELL);

    renderer.sdl_set_render_draw_color_vec(palette.snake_body);
    var c: i64 = 0;
    while (c < cornerCount) {
        renderer.sdl_render_fill_rect(corners[c][0] * CELL, corners[c][1] * CELL, CELL, CELL);
        c++;
    }

    var s: i64 = 0;
    while (s < segLength) {
        var drawX: i64 = prevSegX[s] * CELL + ((segX[s] - prevSegX[s]) * CELL * tScaled) / 1000;
        var drawY: i64 = prevSegY[s] * CELL + ((segY[s] - prevSegY[s]) * CELL * tScaled) / 1000;

        if (s == 0) {
            renderer.sdl_set_render_draw_color_vec(palette.snake_head);
        } else {
            renderer.sdl_set_render_draw_color_vec(palette.snake_body);
        }
        renderer.sdl_render_fill_rect(drawX, drawY, CELL, CELL);
        s = s + 1;
    }

    renderer.draw_score(score, SCORE_X, palette.led_on, palette.led_off);

    renderer.sdl_render_present();
}


fn main(args: string[]) -> int {
static_if (!EMBEDDED)
    var scriptPath: string = args[0].fabsolute().fparent();
    var palettePath: string = scriptPath.fjoin("palette.json");
    palette = palettePath.fread().from_json();
    if (palette == null) error(c_fmt("Failed to load %s", palettePath.frelative())); 
static_endif
static_if (DEBUG)
    putf("%s - Started!", localtimef(TIMEF));
static_endif
    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();

    rand_seed(seedA, seedB);
    var initResult: i64 = sdl_init(SDLC.INIT_VIDEO);
    if (initResult < 0) {
        puts_error("Failed to initialize SDL");
        return 1;
    }

    var window: SDLWindow = sdl_create_window("Snake", 100, 100, screenW, screenH, SDLC.WINDOW_SHOWN);
    if (window == NULL_SDLWINDOW) {
        puts_error("Failed to create window");
        sdl_quit();
        return 1;
    }

    var renderer: SDLRenderer = window.sdl_create_renderer(-1, SDLC.RENDERER_PRESENTVSYNC);
    if (renderer == NULL_SDLRENDERER) {
        puts_error("Failed to create renderer");
        if (window != NULL_SDLWINDOW)
            window.sdl_destroy_window();
        sdl_quit();
        return 1;
    }

    var segX: i64[896]; 
    var segY: i64[896];
    var prevSegX: i64[896];
    var prevSegY: i64[896];
    var segDir: i64[896][2];

    var corners: i64[896][2];
    var cornerCount: i64 = 0;

    var startX: i64 = GRID_W / 2;
    var startY: i64 = GRID_H / 2;

    segX[0] = startX; segY[0] = startY;
    segX[1] = startX - 1; segY[1] = startY;
    segX[2] = startX - 2; segY[2] = startY;
    var segLength: i64 = 3;

    var initIdx: i64 = 0;
    while (initIdx < segLength) {
        prevSegX[initIdx] = segX[initIdx];
        prevSegY[initIdx] = segY[initIdx];
        segDir[initIdx][0] = 1;
        segDir[initIdx][1] = 0;
        initIdx = initIdx + 1;
    }

    var dir: Vec2 = Vec2{x: 1, y: 0};
    var nextDir: Vec2 = Vec2{x: 1, y: 0};

    var food: Vec2 = place_food(segX, segY, segLength);

    var score: i64 = 0;
    var gameOver: bool = false;
    var running: bool = true;
    var lastMoveTime: i64 = time();

    while (running) {
        var frameStart: i64 = time();

        var event: SDLEvent = sdl_poll_event();
        while (event.type != 0) {
            if (event.type == SDLC.QUIT) {
                running = false;
            }
            else if (event.type == SDLC.KEYDOWN) {
                switch (event.key_sym) {
                    case SDLC.K_ESCAPE: 
                        running = false;
                
                    case SDLC.K_SPACE: 
                        if (gameOver) {
                            segX[0] = startX;     segY[0] = startY;
                            segX[1] = startX - 1; segY[1] = startY;
                            segX[2] = startX - 2; segY[2] = startY;
                            segLength = 3;

                            var resetIdx: i64 = 0;
                            while (resetIdx < segLength) {
                                prevSegX[resetIdx] = segX[resetIdx];
                                prevSegY[resetIdx] = segY[resetIdx];
                                segDir[resetIdx][0] = 1;
                                segDir[resetIdx][1] = 0;
                                resetIdx = resetIdx + 1;
                            }
                            cornerCount = 0;

                            dir.x = 1; dir.y = 0;
                            nextDir.x = 1; nextDir.y = 0;

                            score = 0;
                            gameOver = false;
                            lastMoveTime = time();

                            var newFood: Vec2 = place_food(segX, segY, segLength);
                            food.x = newFood.x;
                            food.y = newFood.y;
                        }
                    default:
                        var d: Vec2 = dir_from_key(event.key_sym, dir.x, dir.y, nextDir.x, nextDir.y);
                        nextDir.x = d.x;
                        nextDir.y = d.y;
                }
            }

            event = sdl_poll_event();
        }

        if (!gameOver) {
            var now: i64 = time();
            if (now - lastMoveTime >= MOVE_MS) {
                lastMoveTime = now;

                var snapIdx: i64 = 0;
                while (snapIdx < segLength) {
                    prevSegX[snapIdx] = segX[snapIdx];
                    prevSegY[snapIdx] = segY[snapIdx];
                    snapIdx = snapIdx + 1;
                }

                var oldSegLength: i64 = segLength;

                dir.x = nextDir.x;
                dir.y = nextDir.y;
                
                var newHead: Vec2 = Vec2{x: segX[0] + dir.x, y: segY[0] + dir.y};

                if (newHead.x < 0 || newHead.x >= GRID_W || newHead.y < 0 || newHead.y >= GRID_H) {
                    gameOver = true;
static_if (DEBUG)
                    putf("%s - ran into wall...", localtimef(TIMEF));
static_endif
                }
                else if (is_on_snake(newHead, segX, segY, segLength)) {
                    gameOver = true;
static_if (DEBUG)
                    putf("%s - ran into self...", localtimef(TIMEF));
static_endif
                }
                else {
                    var ate: bool = (newHead.x == food.x && newHead.y == food.y);
                    var growBy: i64 = 0;
                    if (ate) growBy = 1;

                    var i: i64 = segLength - 1 + growBy;
                    while (i > 0) {
                        segX[i] = segX[i - 1];
                        segY[i] = segY[i - 1];
                        i = i - 1;
                    }
                    segX[0] = newHead.x;
                    segY[0] = newHead.y;

                    if (ate) {
static_if (DEBUG)
                        putf("%s - ate apple...", localtimef(TIMEF));
static_endif
                        segLength = segLength + 1;

                        prevSegX[segLength - 1] = segX[segLength - 1];
                        prevSegY[segLength - 1] = segY[segLength - 1];
                        segDir[segLength - 1][0] = dir.x;
                        segDir[segLength - 1][1] = dir.y;

                        score = score + 1;

                        var newFood: Vec2 = place_food(segX, segY, segLength);
                        food.x = newFood.x;
                        food.y = newFood.y;
                    }

                    cornerCount = 0;
                    var ci: i64 = 0;
                    while (ci < oldSegLength) {
                        var stepDX: i64 = segX[ci] - prevSegX[ci];
                        var stepDY: i64 = segY[ci] - prevSegY[ci];

                        if (is_corner_turn(stepDX, stepDY, segDir[ci][0], segDir[ci][1])) {
                            corners[cornerCount][0] = prevSegX[ci];
                            corners[cornerCount][1] = prevSegY[ci];
                            cornerCount = cornerCount + 1;
                        }

                        segDir[ci][0] = stepDX;
                        segDir[ci][1] = stepDY;

                        ci = ci + 1;
                    }
                }
            }
        }

        var tScaled: i64 = 1000;
        if (!gameOver) {
            var elapsed: i64 = frameStart - lastMoveTime;
            if (elapsed < 0) elapsed = 0;
            tScaled = (elapsed * 1000) / MOVE_MS;
            if (tScaled > 1000) tScaled = 1000;
        }

        renderer.render_frame(segX, segY, prevSegX, prevSegY, segLength, corners, cornerCount, food, score, gameOver, tScaled);

        var frameElapsed: i64 = time() - frameStart;
        var delayTime: i64 = FRAMETIME - frameElapsed;
        if (delayTime > 0) {
            sdl_delay(delayTime);
        }
    }
    if (renderer != NULL_SDLRENDERER)
        renderer.sdl_destroy_renderer();
    if (window != NULL_SDLWINDOW)
        window.sdl_destroy_window();
    sdl_quit();

    return 0;
}

include "std/main";