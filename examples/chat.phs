#!/usr/bin/env phasor

include "std/array";
include "std/io";
include "std/type";
include "std/str";
include "std/math";
include "std/file";
include "std/net";
include "std/rand";

struct Packet {
    msg: string,
    status: bool
}

var base_delay: float = 1.0;
var max_delay: float = 20.0;

fn get_delay(attempt: i64) {
    var exp_backoff: float = base_delay * math_pow(2.0, attempt);
    var cap_backoff: float = math_min(max_delay, exp_backoff);
    return rand_next_float_range(0.0, cap_backoff);
}

fn chat_loop(fd: int, is_host: bool) {
    net_set_option(fd, "keepalive", true);
    
    var my_turn: bool = is_host;
    var connected: bool = true;
    
    while (connected) {
        if (my_turn) {
            print("You: ");
            var message: string = gets();
            if (message.len() == 0) {
                break;
            } else {
                fwrite(fd, Packet{msg: message, status: true}.to_json().concat("\n")); 
            }
            my_turn = false;
        } else {
            puts("Waiting on response...");
            var res: string = freadln(fd);
            if (res == null) res = freadln(fd);
            for (var i: i64 = 0; i < 5; i++) {
                sleep(get_delay(i) * 1000);
                if (res == null) res = freadln(fd);
                else break;
            }
            if (res == null) {
                var msg: string;
                if (is_host) msg = "[Client disconnected!]";
                else msg = "[Host disconnected!]";
                puts(msg);
                connected = false;
                break;
            }

            var packet: Packet = res.from_json();
            if (packet.status == true)
                putf("Peer: %s", packet.msg);
            else {
                
                connected = false;
                break;
            } 
            my_turn = true;
        }
    }
    if (connected)
        fwrite(fd, Packet{msg: "", status: false}.to_json().concat("\n"));
    else {
        var msg: string;
        if (is_host) msg = "[Client disconnected!]";
        else msg = "[Host disconnected!]";
        puts(msg);
    }
    fclose(fd);
}

fn run_host(port: int) {
    var listener: int = net_listen("0.0.0.0", port, 10);
    if (listener == null) {
        puts("Error: Could not start server.");
        return;
    }

    putf("Hosting chat on port %d. Waiting for someone to join...", port);
    
    var client: Connection = net_accept(listener, 3600000); 
    if (client == null) {
        puts("Timeout waiting for connection.");
        net_close_listener(listener);
        return;
    }

    putf("User joined from %s:%d! Type a message and press Enter. Send nothing to quit.", client.host, client.port);
    net_close_listener(listener);

    chat_loop(client.fd, true);
}

fn run_joiner(host: string, port: int) {
    putf("Connecting to %s:%d...", host, port);
    var fd: int = net_connect(host, port, 5000);
    
    if (fd == null) {
        puts("Failed to connect to host.");
        return;
    }

    puts("Connected! Send nothing to quit. Wait for Host to speak first...");
    chat_loop(fd, false);
}

fn main(args: string[]) -> int {
    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();
    rand_seed(seedA, seedB);

    if (args.len() < 3) {
        puts("Usage:");
        puts("  chat host <port>");
        puts("  chat join <ip> <port>");
        return 1;
    }

    var mode: string = args[1];
    switch (mode) {
        case "host":
            run_host(args[2].to_int());
        case "join":
            run_joiner(args[2], args[3].to_int());
        default:
            puts("Unknown mode. Use 'host' or 'join'.");
            return 1;
    }

    return 0;
}

include "std/main";