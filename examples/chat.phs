#!/usr/bin/env phasor

include "std/array";
include "std/type";
include "std/str";
include "std/math";
include "std/file";
include "std/net";
include "std/rand";

struct Packet {
    msg: string
}

var base_delay: float = 1.0;
var max_delay: float = 60.0;

fn get_delay(attempt: i64) {
    var exp_backoff: float = base_delay * math_pow(2.0, attempt);
    var cap_backoff: float = math_min(max_delay, exp_backoff);
    return rand_next_float_range(0.0, cap_backoff);
}

fn chat_loop(fd: int, is_host: bool) {
    net_set_option(fd, "keepalive", true);
    
    var my_turn: bool = is_host;
    
    while (true) {
        if (my_turn) {
            fappend(std_stream.out, "You: ");
            var message: string = gets();
            var disconnect: bool = message.len() == 0;
            var pkt: Packet = Packet{
                msg: message
            };
            
            fwrite(fd, pkt.to_json().concat("\n")); 
            my_turn = false;
        } else {
            fwrite(std_stream.out, "Waiting for response...\n");
            var res: string = freadln(fd);
            if (res == null) res = freadln(fd);
            for (var i: i64 = 0; i < 5; i++) {
                sleep(get_delay(i) * 1000);
                if (res == null) res = freadln(fd);
                else break;
            }
            if (res == null) {
                var msg: string;
                if (is_host) msg = "[Client disconnected!]\n";
                else msg = "[Host disconnected!]\n";
                fwrite(std_stream.err, msg);
                break;
            }

            var peer_msg: Packet = res.from_json();
            
            fwrite(std_stream.out, c_fmt("Peer: %s", peer_msg.msg));
            my_turn = true;
        }
    }
    
    fclose(fd);
}

fn run_host(port: int) {
    var listener: int = net_listen("0.0.0.0", port, 10);
    if (listener == null) {
        fwrite(std_stream.out, "Error: Could not start server.\n");
        return;
    }

    fwrite(std_stream.out, c_fmt("Hosting chat on port %d. Waiting for someone to join...\n", port));
    
    var client: Connection = net_accept(listener, 3600000); 
    if (client == null) {
        fwrite(std_stream.out, "Timeout waiting for connection.\n");
        net_close_listener(listener);
        return;
    }

    fwrite(std_stream.out, c_fmt("User joined from %s:%d! Type a message and press Enter.\n", client.host, client.port));
    net_close_listener(listener);

    chat_loop(client.fd, true);
}

fn run_joiner(host: string, port: int) {
    fwrite(std_stream.out, c_fmt("Connecting to %s:%d...\n", host, port));
    var fd: int = net_connect(host, port, 5000);
    
    if (fd == null) {
        fwrite(std_stream.out, "Failed to connect to host.\n");
        return;
    }

    fwrite(std_stream.out, "Connected! Waiting for Host to speak first...\n");
    chat_loop(fd, false);
}

fn main(args: string[]) -> int {
    var seedA: i64 = rand_crypto_int();
    while (seedA < 1) seedA = rand_crypto_int();
    var seedB: i64 = rand_crypto_int();
    while (seedB < 1) seedB = rand_crypto_int();

    if (args.len() < 3) {
        fwrite(std_stream.out, "Usage:\n");
        fwrite(std_stream.out, "  chat host <port>\n");
        fwrite(std_stream.out, "  chat join <ip> <port>\n");
        return 1;
    }

    var mode: string = args[1];
    switch (mode) {
        case "host":
            run_host(args[2].to_int());
        case "join":
            run_joiner(args[2], args[3].to_int());
        default:
            fwrite(std_stream.out, "Unknown mode. Use 'host' or 'join'.\n");
            return 1;
    }

    return 0;
}

include "std/main";