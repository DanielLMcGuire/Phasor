include "std/data";
include "std/sys";

fn main(args: string[]) -> int {
    if (args.len() == 2) {
        if ((args[1] == "-d" || args[1] == "--decode") && !isatty()) {
            print base64_decode(get_input());
            return 0;
        } else {
            print base64_encode(args[1], false);
            return 0;
        }
    } else if (args.len() == 3 && (args[1] == "-d" || args[1] == "--decode")) {
        print base64_decode(args[2]);
        return 0;
    } else if (!isatty()) {
        print base64_encode(get_input(), false);
        return 0;
    }
    return 1;
}

include "std/main";