#!/usr/bin/env phasor
define NO_CHECK_OS;
include "std/io";
include "std/type";
include "std/str";
include "std/file";
include "std/sys";

struct timeBase {
    UTC: string,
    LOCAL: string
}
struct timeStruct {
    TwentyFourHour: timeBase,
    TwelveHour: timeBase
}

fn getTimeStruct() -> timeStruct {
    var fmtFlags: string[2] = [
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %I:%M:%S"
    ];

    return timeStruct{
        TwentyFourHour: timeBase{
            UTC: timef(fmtFlags[0]), 
            LOCAL: localtimef(fmtFlags[0])
        },
        TwelveHour: timeBase{
            UTC: timef(fmtFlags[1]), 
            LOCAL: localtimef(fmtFlags[1])
        }
    };
}

fn main(args: string[]) -> int {
    var helpStr: string = concat("Expected 1 or 2 optional args: ", args[0].fname(), " [-local] [FORMAT]");
    var indent: int = 2;

    if (args.len() >= 2) {
        if (args[1] == "-local") {
            if (args.len() != 3) {
                puts_error(helpStr);
                return 1;
            }
            puts(localtimef(args[2]));
            return 0;
        } else {
            if (args.len() != 2) {
                puts_error(helpStr);
                return 1;
            }
            puts(timef(args[1]));
            return 0;
        }
    } else {
        var times: timeStruct = getTimeStruct();
        putf("24:\n%*sUTC:%*s%s\n%*sLOCAL: %s", indent, "", indent + 1, "",
            times.TwentyFourHour.UTC, indent, "", times.TwentyFourHour.LOCAL);
        putf("12:\n%*sUTC:%*s%s\n%*sLOCAL: %s", indent, "", indent + 1, "",
                times.TwelveHour.UTC, indent, "", times.TwelveHour.LOCAL);
    }

    return 0;
}

include "std/main";