#!/usr/bin/env phasor
define NO_CHECK_OS;
include "std/io";
include "std/type";
include "std/file";
include "std/array";
include "std/sys";
include "std/str";

static_if (PHS_DEBUG && WIN32)
undefine NO_CHECK_OS;
include "win32/windows.phs";
static_endif // (PHS_DEBUG && WIN32)

fn msToSeconds(milli: float) -> float
{
    return milli / 1000;
}

fn secondsToMinutes(seconds: float) -> string
{
    if (seconds < 60)
        return c_fmt("%fs", seconds);

    var mins: int = seconds / 60;
    var secs: int = seconds % 60;

    if (secs < 10)
        return c_fmt("%d:0%ds", mins, secs);

    return c_fmt("%d:%ds", mins, secs);
}

struct ChunkStats
{
    chunk_time: float,
    total_time: float,
    eta: float,
    generation_start: int,
    generation_end: int
}

fn printChunkStats(stats: ChunkStats) -> void 
{
    prints("\r                                                                        ");

    printf("\rGENERATION %d-%d TIME: %s, TOTAL: %s, ETA: %s",
        stats.generation_start,
        stats.generation_end,
        secondsToMinutes(stats.chunk_time),
        secondsToMinutes(stats.total_time),
        secondsToMinutes(stats.eta)
    );
}

struct Rule110State
{
    width: int,
    generations: int,
    stdout: bool,

    board: bool[],
    next_board: bool[],

    generation: int,

    start_time: float,
    last_chunk_start: float,

    avg_chunk_time: float,
    avg_chunk_count: float
}

fn createBoard(width: int) -> bool[]
{
    if (width <= 0)
    {
        var msg: string = "Width must be greater than 0";
    static_if (PHS_DEBUG && WIN32)
        var res: int = MessageBox(NULL_HWND, c_fmt("%s, would you like to debug?", msg), "Error", MB.ICONERROR + MB.OKCANCEL);
        if (res == 2 || res == 0)
            error(msg);
        else
            puts(msg);
            assert(false);
    static_else
            puts(msg);
            assert(false);
            error(msg);
    static_endif
    }
    var board: bool[] = [];

    for (var i: int = 0; i < width; i++)
        board = board.arr_push(false);

    board[width - 1] = true;
    return board;
}

fn boardToString(board: bool[]) -> string 
{
    var sb: int = sb_new().sb_prealloc(board.len());

    for (var i: int = 0; i < board.len(); i++)
    {
        if (board[i])
            sb.sb_append("#");
        else
            sb.sb_append(" ");
    }

    return sb.sb_free();
}

fn createState(
    width: int,
    generations: int,
    stdout: bool
) -> Rule110State 
{
    return Rule110State{
        width: width,
        generations: generations,
        stdout: stdout,

        board: createBoard(width),
        next_board: createBoard(width),

        generation: 0,

        start_time: time(),
        last_chunk_start: time(),

        avg_chunk_time: 0.0,
        avg_chunk_count: 0.0
    };
}

fn computeNextGeneration(state: Rule110State) -> void
{
    var l: bool = false;
    var c: bool = state.board[0];
    
    for (var k: int = 0; k < state.width; k++)
    {
        var r: bool = false;
        
        if (k < state.width - 1)
            r = state.board[k + 1];

        var next_val: bool = false;
        if ((c && !r) || (!c && r) || (!l && c && r))
            next_val = true;

        state.next_board[k] = next_val;

        l = c;
        c = r;
    }

    var tmp: bool[] = state.board;
    state.board = state.next_board;
    state.next_board = tmp;
}

fn calculateChunkStats(state: Rule110State, generation: int, now: float) -> ChunkStats 
{
    var chunk_time: float =
        msToSeconds(now - state.last_chunk_start);

    state.avg_chunk_time =
        state.avg_chunk_time + chunk_time;

    state.avg_chunk_count =
        state.avg_chunk_count + 1;

    var average: float =
        state.avg_chunk_time /
        state.avg_chunk_count;

    var chunks_done: float =
        state.avg_chunk_count;

    var chunks_total: float =
        state.generations / 500.0;

    var eta: float =
        (chunks_total - chunks_done) * average;

    return ChunkStats{
        chunk_time: chunk_time,
        total_time: msToSeconds(now - state.start_time),
        eta: eta,
        generation_start: generation - 499,
        generation_end: generation
    };
}

struct rule110_args
{
    width: int,
    generations: int,
    stdout: bool,
    logfile: string
}

fn createArgs(width: int, generations: int) -> rule110_args
{
    return rule110_args{
        width: width,
        generations: generations,
        stdout: false,
        logfile: "outfile.txt"
    };
}

fn rule110(args: rule110_args) -> int 
{
    if (!args.stdout)
        concat("Output at ", args.logfile).puts();

    var fd: int = fopen(args.logfile, "w");
    var state: Rule110State =
        createState(args.width, args.generations, args.stdout);
    var file_buffer: int = fmemopen("rw");

    if (!args.stdout)
    {
        printf("GENERATION 0 TIME: %s", secondsToMinutes(
            msToSeconds(time() - state.start_time)
        ));
    }

    for (var g: int = 0; g <= args.generations; g++)
    {
        state.generation = g;
        var board_string: string = boardToString(state.board);
        if (args.stdout) board_string.puts();

        file_buffer.fwrite(board_string);
        file_buffer.fwrite("\n");
        computeNextGeneration(state);

        if (g != 0 && (g % 500 == 0))
        {
            var chunk: string = file_buffer.fread();
            file_buffer.fclose();
            file_buffer = fmemopen("rw");
            fd.fwrite(chunk);

            if (!args.stdout)
            {
                var now: float = time();
                var stats: ChunkStats =
                    calculateChunkStats(
                        state,
                        g,
                        now
                    );

                printChunkStats(stats);
                state.last_chunk_start = now;
            }
        }
    }

    var chunk: string = file_buffer.fread(); file_buffer.fclose();
    
    fd.fwrite(chunk);
    fd.fclose();

    putf(
        "\nTOTAL: %s",
        secondsToMinutes(
            msToSeconds(time() - state.start_time)
        )
    );

    return 0;
}

fn printHelp(programName: string) -> string
{
    return c_fmt(`%s WIDTH GENERATIONS STDOUT [OUTFILE]
    WIDTH - Width of board
    GENERATIONS - Length of board
    STDOUT - Print out to stdout? (true/false)
    OUTFILE - File to output into`, programName);
}

fn main(args: string[]) -> int
{
    if (args.len() > 5 || args.len() < 4)
    {
        printHelp(args[0].fstem()).puts();
        return 1;
    }
    if (args[1] == "-h" || args[1] == "--help")
    {
        printHelp(args[0].fstem()).puts();
        return 0;
    }
    var parsedArgs: rule110_args = createArgs(args[1].to_int(), args[2].to_int());
    if (args[3] == "true" || args[3] == "t" || args[3] == "1")
        parsedArgs.stdout = true;
    if (args.len() == 5)
        parsedArgs.logfile = args[4];
    return rule110(parsedArgs);
}
include "std/main";