#!/usr/bin/env phasor
include "std/file";
include "std/io";
include "std/ini";
include "std/sys";
include "std/type";

fn showHelp(programName: string) -> void {
    printf(`INI to JSON converter
Usage: %s IN [INDENT]
  IN      INI File
  INDENT  How much to indent the JSON file

Examples:
  %s file.ini 2
  cat file.ini | %s
  %s file.ini > file.json
  cat file.ini | %s - 4
`, programName, programName, programName, programName, programName);
}

fn doConversion(infile: string, indent: int) -> bool {
    if (infile == "-") {
        print get_input().ini_read().to_json(indent);
        return true;
    } else if (fexists(infile)) {
        print infile.fread().ini_read().to_json(indent);
        return true;
    }
    return false;
}

fn main(args: string[]) -> int {
    if (!isatty()) {
        doConversion("-", -1);
        return 0;
    } else if (args.len() == 2) {
        if (doConversion(args[1], -1)) return 0;
        else { 
            showHelp(args[0].fname());
            return 1;
        }
    } else if (args.len() == 3) {
        if (doConversion(args[1], args[2].to_int())) return 0;
        else { 
            showHelp(args[0].fname());
            return 1;
        }
    }
    showHelp(args[0].fname());
    return 1;
}
include "std/main";