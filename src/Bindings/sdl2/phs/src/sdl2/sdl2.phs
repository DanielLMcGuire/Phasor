include "../../include/sdl2/types/sdl2.phs";

fn sdl_init(flags: i64) -> i64 {
    return SDL_Init(flags); 
}

fn sdl_create_window(
    title: string,
    x: i64,
    y: i64,
    w: i64,
    h: i64,
    flags: i64
    ) -> SDLWindow
{
    var handle: i64 = SDL_CreateWindow(title, x, y, w, h, flags);
    
    return SDLWindow { handle: handle };
}

fn sdl_destroy_window(window: SDLWindow)
{
    SDL_DestroyWindow(window.handle);
}

fn sdl_delay(ms: i64)
{
    SDL_Delay(ms);
}

fn sdl_poll_event() -> SDLEvent
{
    return SDL_PollEvent();
}

fn sdl_create_renderer(window: SDLWindow, index: i64, flags: i64) -> SDLRenderer
{
    var handle: i64 = SDL_CreateRenderer(window.handle, index, flags);
    return SDLRenderer { handle: handle };
}

fn sdl_destroy_renderer(renderer: SDLRenderer)
{
    SDL_DestroyRenderer(renderer.handle);
}

fn sdl_set_render_draw_color(renderer: SDLRenderer, r: i64, g: i64, b: i64, a: i64)
{
    SDL_SetRenderDrawColor(renderer.handle, r, g, b, a);
}

fn sdl_set_render_draw_color_vec(renderer: SDLRenderer, color: Vec4)
{
    SDL_SetRenderDrawColor(renderer.handle, color.x, color.y, color.z, color.w);
}

fn sdl_render_clear(renderer: SDLRenderer)
{
    SDL_RenderClear(renderer.handle);
}

fn sdl_render_present(renderer: SDLRenderer)
{
    SDL_RenderPresent(renderer.handle);
}

fn sdl_render_draw_line(renderer: SDLRenderer, x1: i64, y1: i64, x2: i64, y2: i64)
{
    SDL_RenderDrawLine(renderer.handle, x1, y1, x2, y2);
}

fn sdl_render_draw_line_vec(renderer: SDLRenderer, line: Vec4)
{
    SDL_RenderDrawLine(renderer.handle, line.x, line.y, line.z, line.w);
}

fn sdl_render_draw_rect(renderer: SDLRenderer, x: i64, y: i64, w: i64, h: i64)
{
    SDL_RenderDrawRect(renderer.handle, x, y, w, h);
}

fn sdl_render_draw_rect_vec(renderer: SDLRenderer, rect: Vec4)
{
    SDL_RenderDrawRect(renderer.handle, rect.x, rect.y, rect.z, rect.w);
}

fn sdl_render_fill_rect(renderer: SDLRenderer, x: i64, y: i64, w: i64, h: i64)
{
    SDL_RenderFillRect(renderer.handle, x, y, w, h);
}

fn sdl_render_fill_rect_vec(renderer: SDLRenderer, rect: Vec4)
{
    SDL_RenderFillRect(renderer.handle, rect.x, rect.y, rect.z, rect.w);
}

fn sdl_quit()
{
    SDL_Quit();
}