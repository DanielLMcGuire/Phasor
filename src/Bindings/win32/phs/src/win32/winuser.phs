include "../../include/win32/types/handle.phs";
include "std/type";

fn IsWindow(hWnd: HWND) -> bool
{
    if (hWnd.data.get_type() != phs_type.i64 || hWnd.data == 0)
        return false;
    return win32_IsWindow(hWnd.data);
}

fn GetForegroundWindow() -> HWND
{
    return HWND{ data: win32_GetForegroundWindow() };
}

fn GetDesktopWindow() -> HWND
{
    return HWND{ data: win32_GetDesktopWindow() };
}

fn SetWindowText(hWnd: HWND, String: string) -> bool
{
    if (hWnd.data.get_type() != phs_type.i64 || hWnd.data == 0)
        return false;
    return win32_SetWindowTextA(hWnd.data, String);
}

fn MessageBox(hWnd: HWND, Text: string, Caption: string, Type: i64) -> i64
{
    if (hWnd.data.get_type() != phs_type.i64 || hWnd.data == 0)
        return win32_MessageBoxA(null, Text, Caption, Type);
    return win32_MessageBoxA(hWnd.data, Text, Caption, Type);
}

fn CreateWindowEx(
    ExStyle: i64, 
    ClassName: string, 
    WindowName: string, 
    Style: i64,
    x: i64, 
    y: i64, 
    nWidth: i64, 
    nHeight: i64, 
    hWndParent: HWND, 
    hMenu: HMENU, 
    hInstance: HINSTANCE
    ) -> HWND
{
    var hWndParentReal: any = null;
    if (hWndParent.data.get_type() == phs_type.i64) hWndParentReal = hWndParent.data;
    var hMenuReal: any = null;
    if (hMenu.data.get_type() == phs_type.i64) hMenuReal = hMenu.data;
    var hInstanceReal: any = null;
    if (hInstance.data.get_type() == phs_type.i64) hInstanceReal = hInstance.data;

    return HWND{ data: win32_CreateWindowExW(
        ExStyle, ClassName, WindowName, Style,
        x, y, nWidth, nHeight, hWndParentReal,
        hMenuReal, hInstanceReal)
    };
}