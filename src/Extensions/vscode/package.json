{
  "name": "phasor-programming-language",
  "publisher": "phasor",
  "displayName": "Phasor Programming Language",
  "description": "Function VM Based Programming Language",
  "version": "4.0.0",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielLMcGuire/phasor"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "esbuild extension.ts --platform=node --external:vscode --bundle --sourcemap --outfile=extension.js && vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "phasor",
        "aliases": [
          "Phasor",
          "phasor"
        ],
        "extensions": [
          "phs"
        ],
        "configuration": "./language-configuration-phasor.json",
        "icon": {
          "light": "./icons/phasor-file-icon.svg",
          "dark": "./icons/phasor-file-icon.svg"
        }
      },
      {
        "id": "phasor-ir",
        "aliases": [
          "PhasorIR",
          "phasor-ir"
        ],
        "extensions": [
          "phir"
        ],
        "configuration": "./language-configuration-ir.json",
        "icon": {
          "light": "./icons/phasor-ir-file-icon.svg",
          "dark": "./icons/phasor-ir-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "phasor",
        "scopeName": "source.phasor",
        "path": "./syntaxes/phasor.tmLanguage.json"
      },
      {
        "language": "phasor-ir",
        "scopeName": "source.phasor-ir",
        "path": "./syntaxes/phasor-ir.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "phasor.run",
        "title": "Run Phasor File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "phasor.run",
          "when": "resourceLangId == phasor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Phasor",
      "properties": {
        "phasor.mainExePath": {
          "type": "string",
          "default": "phasor",
          "description": "Path to the Phasor executable."
        },
        "phasor.mainExeArgs": {
          "type": "array",
          "default": [],
          "description": "Additional arguments to pass to the Phasor executable.",
          "items": {
            "type": "string"
          }
        },
        "phasor.clearOutputBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the output panel before running a file."
        },
        "phasor.lspPath": {
          "type": "string",
          "default": "phasor-lsp",
          "description": "Path to the Phasor Language Server executable."
        },
        "phasor.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "verbose",
          "description": "Traces the communication between VS Code and the Phasor language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/vscode": "^1.108.1",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "typescript": "^5.9.3"
  }
}
