fn writeStatus(text: string, paths: ProjectPaths, project: ProjectConfig) -> bool {
    var fileName: string = c_fmt(paths.lockTpl, project.name);
    var tmpFile: string = c_fmt("%s.tmp", fileName);
    if (fexists(fileName)) {
        if (!frm(fileName)) {
            puts_error("Failed to delete old status file");
            return false;
        }
    }
    if (!fwrite(tmpFile, text)) {
        puts_error("Failed to write temp status file");
        return false;
    } else {
        if (!fmv(tmpFile, fileName)) {
            puts_error("Failed to move status file");
            return false;
        }
    }
    return true;
}

fn clearStatus(paths: ProjectPaths, project: ProjectConfig) -> bool {
    var fileName: string = c_fmt(paths.lockTpl, project.name);
    if (fexists(fileName)) {
        if (!frm(fileName)) {
            puts_error("Failed to delete status file");
            return false;
        }
    }
    return true;
}