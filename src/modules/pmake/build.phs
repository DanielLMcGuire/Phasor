fn configure(paths: ProjectPaths, preset: string, defines: string[]) -> bool {
    var args: string[] = ["-S", paths.src, "-B", paths.out, "--preset", preset];
    var dispArgs: string[] = ["-S", paths.src.frelative(), "-B", paths.out.frelative(), "--preset", preset];
    for (var i: int = 0; i < defines.len(); i++) {
        args.arr_push("-D".concat(defines[i]));
        dispArgs.arr_push("-D".concat(defines[i]));
    }
    putf("Using defines: %s\nRunning: cmake %s", defines.arr_join(", "), dispArgs.arr_join(" "));
    var p: sys_fork_out = sys_fork("cmake", args);
    return p.status == 0;
}

fn build(paths: ProjectPaths) -> bool {
    var args: string[] = ["-C", paths.out];
    var dispArgs: string[] = ["-C", paths.out.frelative()];
    putf("Running: ninja %s", dispArgs.arr_join(" "));
    var p: sys_fork_out = sys_fork("ninja", args);
    return p.status == 0;
}

fn install(paths: ProjectPaths) -> bool {
    var args: string[] = ["--install", paths.out, "--prefix", paths.install];
    var dispArgs: string[] = ["--install", paths.out.frelative(), "--prefix", paths.install.frelative()];
    putf("Running: cmake %s", dispArgs.arr_join(" "));
    var p: sys_fork_out = sys_fork("cmake", args);
    return p.status == 0;
}