// enum class ValueType : u8
struct phs_type_def {
    void: int,
    bool: int,
    int: int,
    i64: int,
    float: int,
    f64: int,
    string: int,
    object: int,
    array: int
}

var phs_type: phs_type_def = {
    // ValueType::Null
    void: 0, 
    // ValueType::Bool
    bool: 1, 
    // ValueType::Int
    int: 2,  
    i64: 2,  
    // ValueType::Float
    float: 3,
    f64: 3, 
    // ValueType::String
    string: 4,
    // ValueType::Struct
    object: 5, 
    // ValueType::Array
    array: 6
};

var phs_type_map: string[] = [
    "void",
    "bool",
    "i64",
    "f64",
    "string",
    "object",
    "array"
];