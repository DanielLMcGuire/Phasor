struct Instruction {
    op: int,
    o1: int,
    o2: int,
    o3: int
}

struct ScopeVar {
    index: int,
    name: string
}

struct StructInfo {
    name: string,
    firstConstIndex: int,
    fieldCount: int,
    fieldNames: string[],
    fieldArrayDims: int[][],
    fieldTypeNames: string[]
}

struct Bytecode {
    instructions: Instruction[],
    constants: any[],
    variables: any,
    scopeVarLists: ScopeVar[][],
    functionEntries: any,
    functionParamCounts: any,
    functionParamTypeNames: any,
    functionParamArrayDims: any,
    functionReturnTypeNames: any,
    functionReturnArrayDims: any,
    nextVarIndex: int,
    structs: StructInfo[],
    structEntries: any
}

struct VM {
    handle: any
}

var NULL_VM: VM = VM{ handle: null };