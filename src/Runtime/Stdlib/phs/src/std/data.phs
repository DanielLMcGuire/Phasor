include "../../include/std/types/mem.phs";


fn base64_encode_native(handle: ManagedMemory) -> string {
    return phs__base64_encode_native(handle.ptr, handle.size);
}

fn base64_decode_native(data: string) -> ManagedMemory {
    return phs__base64_decode_native(data, handle.ptr, handle.size);
}

fn md5_native(handle: ManagedMemory) -> string {
    return phs__md5_native(handle.ptr, handle.size);
}

fn sha1_native(handle: ManagedMemory) -> string {
    return phs__sha1_native(handle.ptr, handle.size);
}

fn sha256_native(handle: ManagedMemory) -> string {
    return phs__sha256_native(handle.ptr, handle.size);
}