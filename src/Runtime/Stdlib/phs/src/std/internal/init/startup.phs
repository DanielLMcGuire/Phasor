phs__std("__phs_init");

define PHSRT_CANARY_SIZE = 2;
define C_NULL = 0;

include "./corruptioncheck.phs";
include "./common.phs";
include "../utils/startup.phs";

fn start() -> void
{
static_if (PHS_TRACE)
    print "start()\n";
static_endif // (PHS_TRACE)
    phsrt_check_support();
static_if (!NO_STACK_COOKIE)
    // int64_t *cookie = malloc(PHSRT_CANARY_SIZE * sizeof(int64_t));
    var cookiePtr: i64 = phs__memory_malloc_native(PHSRT_CANARY_SIZE * 8);
    assert(cookiePtr != C_NULL);
    phsrt_init_canary(cookiePtr);
    phs_push(phs__argv_ptr());
    phs_push(phs__argc_ptr());
    var ret: i64 = phsrt__common_init();
    phsrt__chk_and_free_canary(cookiePtr);
    shutdown(ret);
static_else // (NO_STACK_COOKIE)
    phs_push(phs__argv_ptr());
    phs_push(phs__argc_ptr());
    shutdown(phsrt__common_init());
static_endif // (!NO_STACK_COOKIE)
}
