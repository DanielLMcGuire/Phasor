include "../../../../include/std/types/type.phs";

// Push cookie onto stack, returns pointer
fn phsrt_init_canary(cookiePtr: i64) -> i64
{
static_if (PHS_TRACE)
    print "phsrt_init_canary()\nCreating and allocating canary\n";
static_endif // (PHS_TRACE)
    // int64_t *cookie[2];
    phs__memory_write_native(cookiePtr, 8, rand_crypto_int()); // cookie[0]
    phs__memory_write_offset_native(cookiePtr, 8, 8 * 2, rand_crypto_int()); // cookie[1], offset wants the size, including ALL elements for safety (x2)
    phs_push([phs__memory_read_native(cookiePtr, 8), phs__memory_read_offset_native(cookiePtr, 8, 8 * 2)]);
static_if (PHS_TRACE)
    printf("phsrt_init_canary() -> %#x\n", cookiePtr);
static_endif // (PHS_TRACE)
    return cookiePtr;
}

// takes pointer to cookie, verifies against top stack
fn phsrt__chk_and_free_canary(cookiePtr: i64) -> void
{
static_if (PHS_TRACE)
    printf("phsrt__chk_canary(cookiePtr: %#x)\n", cookiePtr);
static_endif
    var vm_cookie: i64[2] = phs_pop();
    var cookie: i64[2] = [phs__memory_read_native(cookiePtr, 8), phs__memory_read_offset_native(cookiePtr, 8, 8 * 2)];
static_if (PHS_TRACE || PHS_DEBUG)  
    if (vm_cookie[0] != cookie[0] || vm_cookie[1] != cookie[1])
    {
        printf("Canary mismatch, chk: %M != real: %M\nFreeing canary\n", vm_cookie, cookie);
        phs__memory_free_native(cookiePtr);
        assert(false);
    } else {
        print "Canary matches\nFreeing canary\n";
        phs__memory_free_native(cookiePtr);
    }
static_else // (!(PHS_TRACE || PHS_DEBUG))
    if (vm_cookie[0] != cookie[0] || vm_cookie[1] != cookie[1])
    {
        phs__memory_free_native(cookiePtr);
        error("Stack corruption detected.");
    } else phs__memory_free_native(cookiePtr);
static_endif // (PHS_TRACE || PHS_DEBUG)  
}
