phs__std("meta");
include "std/struct";
include "../../include/std/types/meta.phs";

fn get_self() -> Bytecode
{
    return phs__get_self();
}

fn load_bytecode(file_path: string) -> Bytecode
{
    return phs__load_bytecode(file_path);
}

fn save_bytecode(program: Bytecode, file_path: string) -> bool
{
    return phs__save_bytecode(program, file_path);
}

fn self_stack_run(opcode: any) -> any {
    phs__stack_run(opcode);
}

fn vm_push(value: any) -> void
{
    phs_push(value);
}

fn vm_pop() -> any
{
    return phs_pop();
}

fn new_vm() -> VM {
    return VM{handle: phs__new_vm()};
}

fn free_vm(vm: VM) -> bool {
    return phs__free_vm(vm.handle);
}

fn phs_compile(source: string, modulePath: string, includePaths: string[], defines: string[]) -> Bytecode {
    return phs__compile(source, modulePath, includePaths, defines);
}

fn phs_exec(vm: VM, bytecode: Bytecode) -> i64 {
    return phs__exec(vm, bytecode);
}

fn phs_eval(vm: VM, source: string, modulePath: string, includePaths: string[], defines: string[], verbose: bool) -> i64 {
    return phs__eval(vm, source, modulePath, includePaths, defines, verbose);
}