fn phsrt_init_canary() -> i64 {
    var cookiePtr: i64 = phs__memory_malloc_native(4);
    phs__memory_write_native(cookiePtr, 4, rand_crypto_int());
    phs_push(phs__memory_read_native(cookiePtr, 4));
    return cookiePtr;
}

fn phsrt__chk_canary(cookiePtr: i64) -> void {
    var chk: i64 = phs_pop();

    if (chk.get_type() != 2 || chk != phs__memory_read_native(cookiePtr, 4)) {
        phs__memory_free_native(cookiePtr);
        error("Stack corruption detected.");
    }
    phs__memory_free_native(cookiePtr);
}