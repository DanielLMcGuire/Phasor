fn phsrt__build_args(argcPtr: i64, argvPtr: i64) -> string[] {
    var argc: i64 = phs__memory_read_native(argcPtr, 4);
    var argv: string[];

    var ptrSize: i64;
    if (phs__is_32())
        ptrSize = 4;
    else
        ptrSize = 8;

    var argvBasePtr: i64 = phs__memory_read_native(argvPtr, ptrSize);

    for (var i: int = 0; i < argc; i++) {
        var elementPtr: i64 = phs__memory_read_offset_native(argvBasePtr, i * ptrSize, ptrSize);
        argv.arr_push(phs__memory_read_string_native(elementPtr, 1024));
    }

    return argv;
}

fn phsrt__common_init() -> void {
    var ret: i64 = main(phsrt__build_args(phs__argc_ptr(), phs__argv_ptr()));
    
    if (ret.get_type()  != 2) {
        if (sys_os() == 0) // win32 0
            ret = 87; // 0x57 "The parameter is incorrect."
        else
            ret = 22; // EINVAL 22 "Invalid argument"
    }
    shutdown(ret);
}