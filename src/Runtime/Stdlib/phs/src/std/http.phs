include "../../include/std/types/http.phs";

fn http_get(url: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("GET", url, null, headers, timeoutMs);
}

fn http_post(url: string, body: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("POST", url, body, headers, timeoutMs);
}

fn http_put(url: string, body: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("PUT", url, body, headers, timeoutMs);
}

fn http_patch(url: string, body: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("PATCH", url, body, headers, timeoutMs);
}

fn http_delete(url: string, body: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("DELETE", url, body, headers, timeoutMs);
}

fn http_head(url: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("HEAD", url, null, headers, timeoutMs);
}

fn http_options(url: string, headers: HTTPHeader[], timeoutMs: i64) -> HTTPResponse {
    return http_request("OPTIONS", url, null, headers, timeoutMs);
}
